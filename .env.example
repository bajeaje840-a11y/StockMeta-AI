# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_KEYS: Optional multi-key rotation pool (comma-separated or newline-separated).
# Add multiple API keys separated by commas here or in AI Studio environment variables settings.
GEMINI_API_KEYS=

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"


